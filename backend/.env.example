# Copy to .env and fill in. With no key at all the API runs in demo mode
# (deterministic sample responses, no network calls).

# Option 1 - Google Gemini, free tier: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# gemini-3.8-flash is newer but was overloaded on the free tier during testing.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the model before is overloaded or times out (free tier gets busy).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Option 2 - Claude (paid, prepaid credit): https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 is cheaper/faster.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth / token spend)
CLAUDE_EFFORT=medium
# auto = Claude if its key is set, else Gemini. Force with "anthropic" or "gemini".
AI_PROVIDER=auto
# auto = live when the chosen provider has a key, else demo. Force with "live" or "demo".
AI_MODE=auto
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_IMAGES=5
MAX_IMAGE_MB=10
# Set before deploying publicly: visitors must enter it to use the app.
APP_PASSWORD=
# Analysis requests allowed per visitor IP per hour.
RATE_LIMIT_PER_HOUR=60
# true only when running behind a reverse proxy (Render, Railway, nginx).
TRUST_PROXY=false
